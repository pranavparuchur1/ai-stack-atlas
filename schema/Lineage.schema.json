        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "failing": {
          "items": {
            "type": "string"
          },
          "title": "Failing",
          "type": "array"
        }
      },
      "required": [
        "name",
        "status",
        "detail"
      ],
      "title": "CheckResult",
      "type": "object"
    },
    "CheckStatus": {
      "enum": [
        "pass",
        "warn",
        "fail"
      ],
      "title": "CheckStatus",
      "type": "string"
    },
    "LineageNode": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "rows": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
