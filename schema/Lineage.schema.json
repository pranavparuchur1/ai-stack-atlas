    "pipeline_version": {
      "title": "Pipeline Version",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceInfo"
      },
      "title": "Sources",
      "type": "array"
    },
    "row_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Row Counts",
      "type": "object"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/CheckResult"
      },
      "title": "Checks",
      "type": "array"
    },
    "nodes": {
