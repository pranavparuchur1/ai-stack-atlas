# All optional - the pipeline and site work with zero keys (yfinance + static snapshots).

# Fresher intraday quotes for US listings in the pipeline (REST).
FINNHUB_API_KEY=
POLYGON_API_KEY=

# Note: the site's LIVE mode asks each visitor for their own Finnhub key in the
# browser (stored only in that browser's localStorage); no key is ever baked into the build.
